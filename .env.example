VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Gemini ───────────────────────────────────────────────────────────────
# ★ 실제 Gemini 키는 ★서버 전용★ 변수에만 둔다 (VITE_ 접두사 금지 → 번들에 안 들어감).
#   - 로컬: 아래 GEMINI_API_KEY 에 실제 키. vite dev 가 /api/gemini 프록시로 사용.
#   - 배포(Vercel): 대시보드 Environment Variables 에 GEMINI_API_KEY 등록 후 재배포.
GEMINI_API_KEY=
# (선택) 브랜드웹 전용 키. 미설정 시 GEMINI_API_KEY 사용.
GEMINI_API_KEY_BRANDWEB=

# Codex image automation calls the protected server endpoint below. Generate a long random value
# and configure the same value in the local Codex environment as NEXUS_CODEX_RENDER_TOKEN.
NEXUS_CODEX_RENDER_TOKEN=

# Codex-side only: deployed Nexus endpoint. Do not prefix these values with VITE_.
NEXUS_IMAGE_PROXY_URL=https://your-nexus-domain.example/api/codex-imagen

# VITE_GEMINI_API_KEY 는 더 이상 실제 키를 넣지 않는다.
# 모든 Gemini 호출은 /api/gemini 프록시로 우회되며 클라이언트의 key 파라미터는 제거된다.
# 단, 일부 코드가 "키 존재" 가드(if(!apiKey))를 하므로, 가드 통과용 더미 값만 넣는다(노출돼도 무해).
VITE_GEMINI_API_KEY=proxy
VITE_GEMINI_API_KEY_BRANDWEB=proxy

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ─── 운명 관측소 별도 배포 (선택) ──────────────────────────────────────────
# 운명 관측소 전용 도메인(두 번째 Vercel 프로젝트: build:destiny / dist-destiny)의 주소.
# 설정하면 NEXUS 안의 운명 관측소 공유 버튼이 이 주소로 링크를 만든다.
# 미설정 시 같은 오리진의 /destiny.html 링크 사용.
VITE_DESTINY_URL=

# ─── 카카오톡 공유 (선택) ──────────────────────────────────────────────────
# 반려동물 MBTI(pet.html)의 카카오톡 공유 버튼용 JavaScript 키.
# developers.kakao.com 에서 앱 생성 → JavaScript 키 발급 + 플랫폼(Web)에 배포 도메인 등록.
# 미설정 시 OS 공유시트(navigator.share) / 클립보드 복사로 자동 폴백 — 공유 자체는 동작함.
VITE_KAKAO_JS_KEY=
